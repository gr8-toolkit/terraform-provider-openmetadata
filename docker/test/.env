# OpenMetadata acceptance-test environment overrides.
#
# This file is loaded by docker compose alongside docker-compose.yml, which
# uses ${VAR:-default} for every setting.  Only values that differ from the
# upstream defaults are listed here.
#
# RUNNING AGAINST A DIFFERENT VERSION
# ─────────────────────────────────────
# Override OPENMETADATA_VERSION via an environment variable — it takes
# precedence over the value in this file:
#
#   OPENMETADATA_VERSION=2.0.3 make testacc
#   OM_VERSION=2.0.3 make testacc        # make target maps OM_VERSION → env var
#
# HOW TO BUMP THE DEFAULT VERSION
# ─────────────────────────────────
# 1. Update OPENMETADATA_VERSION below.
# 2. Commit.

# ── Default version ────────────────────────────────────────────────────────────
OPENMETADATA_VERSION=1.12.4

# ── Heap reduction (saves ~1 GB on CI runners vs. the 2 GB upstream default) ──
OPENMETADATA_HEAP_OPTS=-Xmx1G -Xms1G
ES_JAVA_OPTS=-Xms512m -Xmx512m

# ── Disable Airflow integration (not needed for provider tests) ───────────────
PIPELINE_SERVICE_CLIENT_ENABLED=false

# ── Reduce log noise in CI ─────────────────────────────────────────────────────
LOG_LEVEL=WARN
